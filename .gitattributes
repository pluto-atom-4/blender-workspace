# Normalize line endings regardless of a given machine's core.autocrlf.
# Without this, a local `core.autocrlf=true` can silently rewrite
# .claude/hooks/*.sh with CRLF on checkout, corrupting the shebang line
# and making the script fail to exec (see issue #19).
* text=auto eol=lf

*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.blend binary
*.blend1 binary
*.blend2 binary
