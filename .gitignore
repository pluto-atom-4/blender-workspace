.idea

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Blender backup files
*.blend1
*.blend2

# OS
.DS_Store

# Claude Code local settings
.claude/settings.local.json

*.png

blender-project/anime/
# Trailing-slash dir patterns can't be re-included by a `!` exception below
# (git refuses to re-include a file whose parent directory is excluded), so
# assets/ uses a `dir/*` wildcard instead to let the two exceptions work.
blender-project/assets/*
!blender-project/assets/hq720.jpg
!blender-project/assets/inverted_pendulum_simulation.py
blender-project/images/
blender-project/renders/*.mp4
blender-project/work/

gh-issue*.*
issue*.json
tasks.md

chore-idea.md
feat-idea.md

# Local context-audit run output (CI writes/discards its own copy)
audit-output.txt

# Externally maintained skill, not vendored here -- install/update from
# https://github.com/pluto-atom-4/pre-commit-enforce-skill
.claude/skills/pre-commit-enforce/

# Webots per-world UI/perspective-state cache (auto-created next to a
# .wbt the moment webots opens/validates it, even in --batch mode --
# confirmed empirically: `webots --batch --mode=fast --minimize
# --no-rendering pendulum_world.wbt` creates .pendulum_world.wbproj on
# the spot). Not meaningful project config, analogous to __pycache__/.
blender-project/physics/worlds/*.wbproj

**/tmp/*