{
  "mcpServers": {
    "blender-local-agent": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/pluto-atom-4/blender-workspace/blender-mcp",
        "run",
        "blender_mcp.py"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_PAT}"
      }
    }
  }
}

